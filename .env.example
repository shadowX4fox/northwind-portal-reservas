# Portal de Reservas — configuración de despliegue. Todas son obligatorias: sin ellas el portal no arranca.
# TODO(architecture): host del Servicio de Reservas no documentado —
#   "TODO: [NOT DOCUMENTED — host del servidor: add to docs/components/reservas-de-salas-northwind/02-servicio-de-reservas.md]"
#   (asset:openapi.yaml del Servicio de Reservas, línea 13). La URL base del contrato es /v1 detrás del ingress (ADR-005).
VITE_SERVICIO_DE_RESERVAS_URL=
# Proveedor de Identidad Northwind (Keycloak 25): issuer del realm y cliente público del portal (ADR-002).
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
# Colector OpenTelemetry de Plataforma Northwind (ADR-004), endpoint OTLP/HTTP base (sin /v1/traces).
VITE_OTEL_COLLECTOR_URL=
